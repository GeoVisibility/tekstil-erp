# ── Yerel geliştirme (docker compose up -d ile açılan PostgreSQL, port 5433)
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5433/erp?schema=public"
DIRECT_URL="postgresql://erp:erp_dev_password@localhost:5433/erp?schema=public"

# ── Canlı (Neon örneği)
# DATABASE_URL = havuzlu adres  (host'ta "-pooler" geçer)  ...?sslmode=require
# DIRECT_URL   = havuzsuz adres (migration'lar için)       ...?sslmode=require

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="degistir-beni-en-az-32-karakter-uzunlugunda-olsun"
